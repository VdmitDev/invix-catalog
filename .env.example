# Copy to .env and replace secrets before use.
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change-this-postgres-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=catalog
# URL that browsers can reach. Change this in production.
MINIO_PUBLIC_URL=http://localhost:3000

# Shared secret used only by the bot to create products through FastAPI.
ADMIN_API_TOKEN=change-this-long-random-token

# Telegram
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to create products.
ADMIN_TELEGRAM_IDS=
# Public HTTPS URL of the Next.js app, required for Telegram Mini Apps.
WEBAPP_URL=https://example.com
# Public HTTPS base URL that routes /telegram/webhook to the bot service.
BOT_WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-this-telegram-webhook-secret
